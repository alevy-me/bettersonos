<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Siri may transcribe "BonTon" as two words or in lowercase; these still reach the app. -->
	<key>INAlternativeAppNames</key>
	<array>
		<dict>
			<key>INAlternativeAppName</key>
			<string>Bon Ton</string>
		</dict>
		<dict>
			<key>INAlternativeAppName</key>
			<string>Bonton</string>
		</dict>
	</array>
	<!-- Same as the iOS app. Do not add NSAllowsLocalNetworking: it makes the system ignore
	     NSAllowsArbitraryLoads and blocks plain HTTP to hostnames such as home.example.com. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
</dict>
</plist>
